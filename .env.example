# MongoDB
MONGODB_URI=mongodb://mongodb:27017/taskmanager

# JWT
JWT_SECRET=change-me-in-production-use-32-random-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-use-32-random-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_BCRYPT_ROUNDS=12

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Pagination
PAGINATION_LIMIT=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
